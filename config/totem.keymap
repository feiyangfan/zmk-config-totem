//
// TOTEM keymap — ergonomic test layout
//
// Thumb taps / holds:
//   Left:  UTL/Esc   NAV/Space   FUN/Tab
//   Right: SYM/Enter Backspace   NUM/Delete
//
// Layers:
//   BASE 0, NAV 1, NUM 2, SYM 3, UTL 4, FUN 5
//

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NAV  1
#define NUM  2
#define SYM  3
#define UTL  4
#define FUN  5

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <250>;
    require-prior-idle-ms = <125>;
};

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;

            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;

            // Opposite-hand trigger positions: RIGHT half only.
            hold-trigger-key-positions = <
                5 6 7 8 9
                15 16 17 18 19
                26 27 28 29 30 31
                35 36 37
            >;

            hold-trigger-on-release;
            display-name = "Home Row Mod Left";
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;

            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;

            // Opposite-hand trigger positions: LEFT half only.
            hold-trigger-key-positions = <
                0 1 2 3 4
                10 11 12 13 14
                20 21 22 23 24 25
                32 33 34
            >;

            hold-trigger-on-release;
            display-name = "Home Row Mod Right";
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };
    };

    macros {
        // Zero-parameter mouse behaviors remain Studio-friendly.
        mouse_move_left: mouse_move_left {
            display-name = "Mouse Move Left";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &mmv MOVE_LEFT>
                , <&macro_pause_for_release>
                , <&macro_release &mmv MOVE_LEFT>
                ;
        };

        mouse_move_right: mouse_move_right {
            display-name = "Mouse Move Right";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &mmv MOVE_RIGHT>
                , <&macro_pause_for_release>
                , <&macro_release &mmv MOVE_RIGHT>
                ;
        };

        mouse_move_up: mouse_move_up {
            display-name = "Mouse Move Up";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &mmv MOVE_UP>
                , <&macro_pause_for_release>
                , <&macro_release &mmv MOVE_UP>
                ;
        };

        mouse_move_down: mouse_move_down {
            display-name = "Mouse Move Down";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &mmv MOVE_DOWN>
                , <&macro_pause_for_release>
                , <&macro_release &mmv MOVE_DOWN>
                ;
        };

        mouse_scroll_up: mouse_scroll_up {
            display-name = "Mouse Scroll Up";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &msc SCRL_UP>
                , <&macro_pause_for_release>
                , <&macro_release &msc SCRL_UP>
                ;
        };

        mouse_scroll_down: mouse_scroll_down {
            display-name = "Mouse Scroll Down";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &msc SCRL_DOWN>
                , <&macro_pause_for_release>
                , <&macro_release &msc SCRL_DOWN>
                ;
        };

        mouse_scroll_left: mouse_scroll_left {
            display-name = "Mouse Scroll Left";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &msc SCRL_LEFT>
                , <&macro_pause_for_release>
                , <&macro_release &msc SCRL_LEFT>
                ;
        };

        mouse_scroll_right: mouse_scroll_right {
            display-name = "Mouse Scroll Right";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &msc SCRL_RIGHT>
                , <&macro_pause_for_release>
                , <&macro_release &msc SCRL_RIGHT>
                ;
        };

        mouse_click_left: mouse_click_left {
            display-name = "Mouse Left Click";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &mkp LCLK>
                , <&macro_pause_for_release>
                , <&macro_release &mkp LCLK>
                ;
        };

        mouse_click_right: mouse_click_right {
            display-name = "Mouse Right Click";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &mkp RCLK>
                , <&macro_pause_for_release>
                , <&macro_release &mkp RCLK>
                ;
        };

        mouse_click_middle: mouse_click_middle {
            display-name = "Mouse Middle Click";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &mkp MCLK>
                , <&macro_pause_for_release>
                , <&macro_release &mkp MCLK>
                ;
        };

        mouse_button_4: mouse_button_4 {
            display-name = "Mouse Button 4";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &mkp MB4>
                , <&macro_pause_for_release>
                , <&macro_release &mkp MB4>
                ;
        };

        mouse_button_5: mouse_button_5 {
            display-name = "Mouse Button 5";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &mkp MB5>
                , <&macro_pause_for_release>
                , <&macro_release &mkp MB5>
                ;
        };

        gif: gif {
            label = "giphy";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LSHFT>
                , <&macro_tap &kp N2>
                , <&macro_release &kp LSHFT>
                , <&macro_tap &kp G &kp I &kp F>
                ;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "BASE";

            //                 Q            W            E            R            T             Y            U            I            O            P
            //                 A/GUI        S/ALT        D/SHIFT      F/CTRL       G             H            J/RCTRL      K/RSHIFT     L/RALT       ;/RGUI
            // TAB             Z            X            C            V            B             N            M            ,            .            /            CAPS
            //                                           UTL/Esc      NAV/Space    FUN/Tab       SYM/Enter    Backspace    NUM/Delete
            bindings = <
                                &kp Q        &kp W        &kp E        &kp R        &kp T          &kp Y        &kp U        &kp I        &kp O        &kp P
                                &hml LGUI A  &hml LALT S  &hml LSHFT D &hml LCTRL F &kp G         &kp H        &hmr RCTRL J &hmr RSHFT K &hmr RALT L  &hmr RGUI SEMI
                &kp TAB        &kp Z        &kp X        &kp C        &kp V        &kp B          &kp N        &kp M        &kp COMMA    &kp DOT      &kp FSLH     &kp CAPS
                                                            &lt UTL ESC  &lt NAV SPACE &lt FUN TAB   &lt SYM ENTER &kp BSPC     &lt NUM DEL
            >;
        };

        nav_layer {
            label = "NAV";

            // Left top: editing shortcuts. Right top: mouse movement + right click.
            // Left home: modifiers.        Right home: HJKL-style arrows + middle click.
            // Left bottom: wheel scroll.   Right bottom: Home/PgDn/PgUp/End + left click.
            // Right thumbs: Enter / Backspace / Delete.
            bindings = <
                                &kp LC(Y)            &kp LC(V)            &kp LC(C)            &kp LC(X)             &kp LC(Z)               &mouse_move_left   &mouse_move_down   &mouse_move_up     &mouse_move_right   &mouse_click_right
                                &kp LGUI             &kp LALT             &kp LSHFT             &kp LCTRL              &none                   &kp LEFT           &kp DOWN            &kp UP              &kp RIGHT           &mouse_click_middle
                &none           &mouse_scroll_left   &mouse_scroll_down   &mouse_scroll_up      &mouse_scroll_right    &none                   &kp HOME           &kp PG_DN           &kp PG_UP           &kp END             &mouse_click_left   &none
                                                                        &trans                 &trans                 &trans                   &kp ENTER          &kp BSPC            &kp DEL
            >;
        };

        num_layer {
            label = "NUM";

            // Right thumb holds NUM; left hand becomes a numpad / numeric-expression pad.
            //                 +            7            8            9            /             .            .            .            .            .
            //                 =            4            5            6            *             .            .            .            .            .
            // .               (            )            1            2            3             .            .            .            .            .            .
            //                                           Enter        0            .             trans        trans        trans
            bindings = <
                                &kp PLUS     &kp N7       &kp N8       &kp N9       &kp FSLH       &none        &none        &none        &none        &none
                                &kp EQUAL    &kp N4       &kp N5       &kp N6       &kp ASTRK      &none        &none        &none        &none        &none
                &none           &kp LPAR     &kp RPAR     &kp N1       &kp N2       &kp N3         &none        &none        &none        &none        &none        &none
                                                            &kp ENTER    &kp N0       &kp DOT        &trans       &trans       &trans
            >;
        };

        sym_layer {
            label = "SYM";

            // Grouped by symbol family; thumbs intentionally transparent for testing.
            //                 [            ]            {            }            `             @            #            $            ^            ~
            //                 (            )            <            >            =             '            "            ?            ;            :
            // .               !            &            |            \\           _             +            -            *            /            %            .
            bindings = <
                                &kp LBKT     &kp RBKT     &kp LBRC     &kp RBRC     &kp GRAVE      &kp AT       &kp HASH     &kp DLLR     &kp CARET    &kp TILDE
                                &kp LPAR     &kp RPAR     &kp LT       &kp GT       &kp EQUAL      &kp SQT      &kp DQT      &kp QMARK    &kp SEMI     &kp COLON
                &none           &kp EXCL     &kp AMPS     &kp PIPE     &kp BSLH      &kp UNDER      &kp PLUS     &kp MINUS    &kp ASTRK    &kp FSLH     &kp PRCNT    &none
                                                            &trans       &trans       &trans          &trans       &trans       &trans
            >;
        };

        utility_layer {
            label = "UTL";

            // Reset/bootloader are deliberately placed on both physical halves.
            // Right hand also carries BT, media, and output controls.
            //                 Reset-L      Boot-L       .            .            .             BT1          BT2          .            Reset-R      Boot-R
            //                 .            .            .            .            .             Prev         Vol-         Mute         Vol+         Next
            // .               .            .            .            .            .             BT Prev      BT Next      BT Clear     USB          BLE          Toggle
            bindings = <
                                &sys_reset   &bootloader  &none        &none        &none          &bt BT_SEL 0 &bt BT_SEL 1 &none        &sys_reset   &bootloader
                                &none        &none        &none        &none        &none          &kp C_PREV   &kp C_VOL_DN &kp C_MUTE   &kp C_VOL_UP &kp C_NEXT
                &none           &none        &none        &none        &none        &none          &bt BT_PRV   &bt BT_NXT   &bt BT_CLR   &out OUT_USB &out OUT_BLE &out OUT_TOG
                                                            &trans       &trans       &trans          &trans       &trans       &trans
            >;
        };

        fun_layer {
            label = "FUN";

            // Left thumb holds FUN; F-keys are concentrated on the right hand.
            // Miryoku-inspired 3x3 F1-F9 pattern, with F10-F12 in the outer column.
            //                 .            .            .            .            .             PrtSc        F7           F8           F9           F12
            //                 .            .            .            .            .             ScrLk        F4           F5           F6           F11
            // .               .            .            .            .            .             Pause        F1           F2           F3           F10          .
            bindings = <
                                &none        &none        &none        &none        &none          &kp PSCRN    &kp F7       &kp F8       &kp F9       &kp F12
                                &none        &none        &none        &none        &none          &kp SLCK     &kp F4       &kp F5       &kp F6       &kp F11
                &none           &none        &none        &none        &none        &none          &kp PAUSE_BREAK &kp F1    &kp F2       &kp F3       &kp F10      &none
                                                            &trans       &trans       &trans          &trans       &trans       &trans
            >;
        };
    };
};
