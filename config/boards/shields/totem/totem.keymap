//
// TOTEM keymap
// BASE / NAV / SYM preserved from current overlay dump.
// NUM redesigned as number + function row.
// UTL contains Bluetooth/output/system/media/mouse-scroll utilities.
//

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NAV  1
#define NUM  2
#define SYM  3
#define UTL  4

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <250>;
    require-prior-idle-ms = <125>;
};

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;

            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;

            // Opposite-hand trigger positions: RIGHT half only.
            hold-trigger-key-positions = <
                5 6 7 8 9
                15 16 17 18 19
                26 27 28 29 30 31
                35 36 37
            >;

            hold-trigger-on-release;
            display-name = "Home Row Mod Left";
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;

            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;

            // Opposite-hand trigger positions: LEFT half only.
            hold-trigger-key-positions = <
                0 1 2 3 4
                10 11 12 13 14
                20 21 22 23 24 25
                32 33 34
            >;

            hold-trigger-on-release;
            display-name = "Home Row Mod Right";
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };
    };

    macros {
        // Reusable zero-parameter mouse behaviors for ZMK Studio.
        mouse_move_left: mouse_move_left {
            display-name = "Mouse Move Left";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &mmv MOVE_LEFT>
                , <&macro_pause_for_release>
                , <&macro_release &mmv MOVE_LEFT>
                ;
        };

        mouse_move_right: mouse_move_right {
            display-name = "Mouse Move Right";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &mmv MOVE_RIGHT>
                , <&macro_pause_for_release>
                , <&macro_release &mmv MOVE_RIGHT>
                ;
        };

        mouse_move_up: mouse_move_up {
            display-name = "Mouse Move Up";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &mmv MOVE_UP>
                , <&macro_pause_for_release>
                , <&macro_release &mmv MOVE_UP>
                ;
        };

        mouse_move_down: mouse_move_down {
            display-name = "Mouse Move Down";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &mmv MOVE_DOWN>
                , <&macro_pause_for_release>
                , <&macro_release &mmv MOVE_DOWN>
                ;
        };

        mouse_scroll_up: mouse_scroll_up {
            display-name = "Mouse Scroll Up";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &msc SCRL_UP>
                , <&macro_pause_for_release>
                , <&macro_release &msc SCRL_UP>
                ;
        };

        mouse_scroll_down: mouse_scroll_down {
            display-name = "Mouse Scroll Down";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &msc SCRL_DOWN>
                , <&macro_pause_for_release>
                , <&macro_release &msc SCRL_DOWN>
                ;
        };

        mouse_scroll_left: mouse_scroll_left {
            display-name = "Mouse Scroll Left";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &msc SCRL_LEFT>
                , <&macro_pause_for_release>
                , <&macro_release &msc SCRL_LEFT>
                ;
        };

        mouse_scroll_right: mouse_scroll_right {
            display-name = "Mouse Scroll Right";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &msc SCRL_RIGHT>
                , <&macro_pause_for_release>
                , <&macro_release &msc SCRL_RIGHT>
                ;
        };

        mouse_click_left: mouse_click_left {
            display-name = "Mouse Left Click";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &mkp LCLK>
                , <&macro_pause_for_release>
                , <&macro_release &mkp LCLK>
                ;
        };

        mouse_click_right: mouse_click_right {
            display-name = "Mouse Right Click";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &mkp RCLK>
                , <&macro_pause_for_release>
                , <&macro_release &mkp RCLK>
                ;
        };

        mouse_click_middle: mouse_click_middle {
            display-name = "Mouse Middle Click";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &mkp MCLK>
                , <&macro_pause_for_release>
                , <&macro_release &mkp MCLK>
                ;
        };

        mouse_button_4: mouse_button_4 {
            display-name = "Mouse Button 4";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &mkp MB4>
                , <&macro_pause_for_release>
                , <&macro_release &mkp MB4>
                ;
        };

        mouse_button_5: mouse_button_5 {
            display-name = "Mouse Button 5";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &mkp MB5>
                , <&macro_pause_for_release>
                , <&macro_release &mkp MB5>
                ;
        };

        gif: gif {
            label = "giphy";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LSHFT>
                , <&macro_tap &kp N2>
                , <&macro_release &kp LSHFT>
                , <&macro_tap &kp G &kp I &kp F>
                ;
        };
    };

    // NAV + SYM -> UTL.
    // This uses the existing NAV-layer &mo SYM thumb key, so BASE/NAV/SYM
    // do not need to be changed merely to reach UTL.
    conditional_layers {
        compatible = "zmk,conditional-layers";

        nav_sym_utl {
            if-layers = <NAV SYM>;
            then-layer = <UTL>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "Base";

            //                 Q            W            E            R            T             Y            U            I            O            P
            //                 A/GUI        S/ALT        D/SHIFT      F/CTRL       G             H            J/RCTRL      K/RSHIFT     L/RALT       ;/RGUI
            // TAB             Z            X            C            V            B             N            M            ,            .            /            CAPS
            //                                           NUM/Esc      NAV/Space    NAV/Esc       Base/Enter   SYM/Bspc     RShift
            bindings = <
                                &kp Q        &kp W        &kp E        &kp R        &kp T          &kp Y        &kp U        &kp I        &kp O        &kp P
                                &hml LGUI A  &hml LALT S  &hml LSHFT D &hml LCTRL F &kp G         &kp H        &hmr RCTRL J &hmr RSHFT K &hmr RALT L  &hmr RGUI SEMI
                &kp TAB        &kp Z        &kp X        &kp C        &kp V        &kp B          &kp N        &kp M        &kp COMMA    &kp DOT      &kp FSLH     &kp CAPS
                                                            &lt NUM ESC  &lt NAV SPACE &lt NAV ESC  &lt BASE ENTER &lt SYM BSPC &kp RSHFT
            >;
        };

        nav_layer {
            label = "NAV";

            //                 ESC          .            .            .            .             M←           M↓           M↑           M→           RClick
            //                 GUI          ALT          SHIFT        CTRL         .             ←            ↓            ↑            →            .
            // TAB(trans)      .            .            .            .            .             HOME         PGDN         PGUP         END          .            CAPS(trans)
            //                                           .            trans        .             SYM          LClick       trans
            bindings = <
                                &kp ESC      &none        &none        &none        &none          &mouse_move_left &mouse_move_down &mouse_move_up &mouse_move_right &mouse_click_right
                                &kp LGUI     &kp LALT     &kp LSHFT   &kp LCTRL    &none          &kp LEFT     &kp DOWN     &kp UP       &kp RIGHT    &none
                &trans          &none        &none        &none        &none        &none          &kp HOME     &kp PG_DN    &kp PG_UP    &kp END      &none         &trans
                                                            &none        &trans       &none          &mo SYM      &mouse_click_left &trans
            >;
        };

        num_layer {
            label = "NUM";

            //                 F1           F2           F3           F4           F5            F6           F7           F8           F9           F10
            //                 1            2            3            4            5             6            7            8            9            0
            // F11             (            )            %            =            +             -            *            /            .            ,            F12
            //                                           trans        trans        trans          trans        trans        trans
            bindings = <
                                &kp F1       &kp F2       &kp F3       &kp F4       &kp F5         &kp F6       &kp F7       &kp F8       &kp F9       &kp F10
                                &kp N1       &kp N2       &kp N3       &kp N4       &kp N5         &kp N6       &kp N7       &kp N8       &kp N9       &kp N0
                &kp F11        &kp LPAR     &kp RPAR     &kp PRCNT    &kp EQUAL    &kp PLUS       &kp MINUS    &kp ASTRK    &kp FSLH     &kp DOT      &kp COMMA    &kp F12
                                                            &trans       &trans       &trans          &trans       &trans       &trans
            >;
        };

        sym_layer {
            label = "SYM";

            // Preserve current Studio/overlay bindings exactly by HID intent.
            bindings = <
                                &none            &none            &kp LS(LBKT)     &kp LS(RBKT)     &kp KP_PLUS      &kp LS(GRAVE)    &kp RS(GRAVE)    &kp LS(N4)       &kp LS(N6)       &none
                                &kp LS(COMMA)    &kp LS(DOT)      &kp LS(N9)       &kp LS(N0)       &kp KP_MINUS     &kp EQUAL        &kp SQT          &kp LS(N2)       &kp LS(N5)       &none
                &none           &none            &none            &kp LBKT         &kp RBKT         &kp LS(N8)       &kp RS(MINUS)    &kp RS(SQT)      &kp BSLH         &kp LS(BSLH)     &none           &none
                                                                        &trans            &trans            &trans            &trans            &trans            &trans
            >;
        };

        utility_layer {
            label = "UTL";

            // Bluetooth profiles 1-5                 | output + system
            // BT prev/next/clear                     | media controls
            // Fewer-used editing keys                | mouse scrolling + play/pause
            bindings = <
                                &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4      &out OUT_USB       &out OUT_BLE       &out OUT_TOG       &sys_reset          &bootloader
                                &bt BT_PRV     &bt BT_NXT     &bt BT_CLR     &none           &none              &kp C_PREV         &kp C_VOL_DN       &kp C_MUTE         &kp C_VOL_UP        &kp C_NEXT
                &none           &kp INS        &kp DEL        &kp PSCRN      &none           &none              &mouse_scroll_left &mouse_scroll_down &mouse_scroll_up   &mouse_scroll_right &kp C_PP            &none
                                                                        &trans            &trans            &trans            &trans            &trans            &trans
            >;
        };
    };
};
